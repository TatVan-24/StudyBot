{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studybot.local/schemas/chunk.schema.json",
  "title": "StudyBot Chunk v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","chunk_id","document_id","chunk_index","text","char_count",
    "token_count","source_type","source_block_ids","page_numbers","heading_context",
    "block_types","chunker_strategy","chunker_config"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "chunk_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{16}$" },
    "document_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "chunk_index": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1 },
    "char_count": { "type": "integer", "minimum": 1 },
    "token_count": { "type": "integer", "minimum": 1 },
    "source_type": { "enum": ["pdf","pptx","docx","markdown","txt"] },
    "source_block_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "page_numbers": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "heading_context": { "type": "array", "items": { "type": "string" } },
    "block_types": { "type": "array", "uniqueItems": true, "items": { "enum": ["title","heading","paragraph","list_item","table_row","caption","code_block","quote"] } },
    "chunker_strategy": { "enum": ["fixed","recursive","semantic","structure","token_aware"] },
    "chunker_config": { "type": "object" }
  }
}
