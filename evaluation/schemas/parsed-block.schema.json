{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://studybot.local/schemas/parsed-block.schema.json",
    "title": "StudyBot ParsedBlock v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "document_id",
        "block_id",
        "source_type",
        "block_index",
        "source_order",
        "block_type",
        "text",
        "heading_path",
        "related_asset_ids",
        "locator",
        "metadata"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "document_id": {
            "type": "string",
            "minLength": 1
        },
        "block_id": {
            "type": "string",
            "minLength": 1
        },
        "source_type": {
            "type": "string",
            "enum": [
                "pdf",
                "pptx",
                "docx",
                "markdown",
                "txt"
            ]
        },
        "block_index": {
            "type": "integer",
            "minimum": 1
        },
        "source_order": {
            "type": "integer",
            "minimum": 1
        },
        "block_type": {
            "type": "string",
            "enum": [
                "title",
                "heading",
                "paragraph",
                "list_item",
                "table_row",
                "caption",
                "code_block",
                "quote"
            ]
        },
        "text": {
            "type": "string",
            "minLength": 1
        },
        "heading_path": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/headingPathItem"
            }
        },
        "related_asset_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "locator": {
            "type": "object"
        },
        "metadata": {
            "type": "object"
        }
    },
    "$defs": {
        "headingPathItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "level",
                "role",
                "text"
            ],
            "properties": {
                "level": {
                    "type": "integer",
                    "minimum": 2
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "chapter",
                        "section",
                        "subsection",
                        "slide",
                        "generic"
                    ]
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "emptyMetadata": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
        },
        "listMetadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "list_id",
                "item_index",
                "list_type",
                "list_level"
            ],
            "properties": {
                "list_id": {
                    "type": "string",
                    "minLength": 1
                },
                "item_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "list_type": {
                    "type": "string",
                    "enum": [
                        "ordered",
                        "unordered"
                    ]
                },
                "list_level": {
                    "type": "integer",
                    "minimum": 0
                },
                "marker": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "tableRowMetadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "table_id",
                "row_index",
                "cells"
            ],
            "properties": {
                "table_id": {
                    "type": "string",
                    "minLength": 1
                },
                "row_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "cells": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/tableCell"
                    }
                }
            }
        },
        "tableCell": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "column_start",
                "column_span",
                "row_span",
                "text"
            ],
            "properties": {
                "column_start": {
                    "type": "integer",
                    "minimum": 1
                },
                "column_span": {
                    "type": "integer",
                    "minimum": 1
                },
                "row_span": {
                    "type": "integer",
                    "minimum": 1
                },
                "text": {
                    "type": "string"
                }
            }
        },
        "captionMetadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "caption_kind",
                "target"
            ],
            "properties": {
                "caption_kind": {
                    "type": "string",
                    "enum": [
                        "figure",
                        "table"
                    ]
                },
                "target": {
                    "$ref": "#/$defs/captionTarget"
                }
            }
        },
        "captionTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "id"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "asset",
                        "table"
                    ]
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "codeBlockMetadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "language": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "quoteMetadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "quote_level"
            ],
            "properties": {
                "quote_level": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "markdownLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "start_line",
                "end_line"
            ],
            "properties": {
                "type": {
                    "const": "markdown"
                },
                "start_line": {
                    "type": "integer",
                    "minimum": 1
                },
                "end_line": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "txtLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "start_line",
                "end_line"
            ],
            "properties": {
                "type": {
                    "const": "txt"
                },
                "start_line": {
                    "type": "integer",
                    "minimum": 1
                },
                "end_line": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "docxParagraphLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "element_type",
                "body_child_index"
            ],
            "properties": {
                "type": {
                    "const": "docx"
                },
                "element_type": {
                    "const": "paragraph"
                },
                "body_child_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "paragraph_id": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{8}$"
                }
            }
        },
        "docxTableRowLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "element_type",
                "body_child_index",
                "physical_row_index"
            ],
            "properties": {
                "type": {
                    "const": "docx"
                },
                "element_type": {
                    "const": "table_row"
                },
                "body_child_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "physical_row_index": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "pptxShapeBoundingBox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "x_min",
                "y_min",
                "x_max",
                "y_max"
            ],
            "properties": {
                "x_min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "y_min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "x_max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "y_max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "pptxTextParagraphLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "element_type",
                "slide",
                "shape_path",
                "shape_id",
                "physical_paragraph_index",
                "shape_bounding_box"
            ],
            "properties": {
                "type": {
                    "const": "pptx"
                },
                "element_type": {
                    "const": "text_paragraph"
                },
                "slide": {
                    "type": "integer",
                    "minimum": 1
                },
                "shape_path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "shape_id": {
                    "type": "integer",
                    "minimum": 1
                },
                "physical_paragraph_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "shape_bounding_box": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/pptxShapeBoundingBox"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "pptxTableRowLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "element_type",
                "slide",
                "shape_path",
                "shape_id",
                "physical_row_index",
                "shape_bounding_box"
            ],
            "properties": {
                "type": {
                    "const": "pptx"
                },
                "element_type": {
                    "const": "table_row"
                },
                "slide": {
                    "type": "integer",
                    "minimum": 1
                },
                "shape_path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "shape_id": {
                    "type": "integer",
                    "minimum": 1
                },
                "physical_row_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "shape_bounding_box": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/pptxShapeBoundingBox"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "pdfBoundingBox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "x_min",
                "y_min",
                "x_max",
                "y_max"
            ],
            "properties": {
                "x_min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "y_min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "x_max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "y_max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "pdfPageLocation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pdf_page",
                "printed_page",
                "bounding_boxes"
            ],
            "properties": {
                "pdf_page": {
                    "type": "integer",
                    "minimum": 1
                },
                "printed_page": {
                    "oneOf": [
                        {
                            "type": "string",
                            "minLength": 1
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "bounding_boxes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/pdfBoundingBox"
                    }
                }
            }
        },
        "pdfLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "occurrence_index",
                "locations"
            ],
            "properties": {
                "type": {
                    "const": "pdf"
                },
                "occurrence_index": {
                    "type": "integer",
                    "minimum": 1
                },
                "locations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/pdfPageLocation"
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "block_type": {
                        "enum": [
                            "title",
                            "heading",
                            "paragraph"
                        ]
                    }
                },
                "required": [
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "metadata": {
                        "$ref": "#/$defs/emptyMetadata"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "block_type": {
                        "const": "list_item"
                    }
                },
                "required": [
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "metadata": {
                        "$ref": "#/$defs/listMetadata"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "block_type": {
                        "const": "table_row"
                    }
                },
                "required": [
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "metadata": {
                        "$ref": "#/$defs/tableRowMetadata"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "block_type": {
                        "const": "caption"
                    }
                },
                "required": [
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "metadata": {
                        "$ref": "#/$defs/captionMetadata"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "block_type": {
                        "const": "code_block"
                    }
                },
                "required": [
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "metadata": {
                        "$ref": "#/$defs/codeBlockMetadata"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "block_type": {
                        "const": "quote"
                    }
                },
                "required": [
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "metadata": {
                        "$ref": "#/$defs/quoteMetadata"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "markdown"
                    }
                },
                "required": [
                    "source_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/markdownLocator"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "txt"
                    }
                },
                "required": [
                    "source_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/txtLocator"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "docx"
                    },
                    "block_type": {
                        "const": "table_row"
                    }
                },
                "required": [
                    "source_type",
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/docxTableRowLocator"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "docx"
                    },
                    "block_type": {
                        "not": {
                            "const": "table_row"
                        }
                    }
                },
                "required": [
                    "source_type",
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/docxParagraphLocator"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "pptx"
                    },
                    "block_type": {
                        "const": "table_row"
                    }
                },
                "required": [
                    "source_type",
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/pptxTableRowLocator"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "pptx"
                    },
                    "block_type": {
                        "not": {
                            "const": "table_row"
                        }
                    }
                },
                "required": [
                    "source_type",
                    "block_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/pptxTextParagraphLocator"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source_type": {
                        "const": "pdf"
                    }
                },
                "required": [
                    "source_type"
                ]
            },
            "then": {
                "properties": {
                    "locator": {
                        "$ref": "#/$defs/pdfLocator"
                    }
                }
            }
        }
    ]
}